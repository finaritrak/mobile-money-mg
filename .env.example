# Route every payment to the offline simulator (no credentials needed)
MOBILE_MONEY_SIMULATOR=1

# Set to true to use production URLs (default: sandbox)
MOBILE_MONEY_PRODUCTION=false

# --- MVola (developer.mvola.mg) ---
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
MVOLA_MERCHANT_NUMBER=0343500004
MVOLA_PARTNER_NAME=MyShop
MVOLA_CALLBACK_URL=https://example.mg/webhooks/mvola

# --- Orange Money Web Payment (developer.orange.com) ---
ORANGE_MERCHANT_KEY=
ORANGE_AUTHORIZATION_HEADER=Basic xxxxxxxx
ORANGE_RETURN_URL=https://example.mg/payment/success
ORANGE_CANCEL_URL=https://example.mg/payment/cancel
ORANGE_NOTIF_URL=https://example.mg/webhooks/orange

# --- Airtel Money (developers.airtel.africa) ---
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
